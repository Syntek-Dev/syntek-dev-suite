{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Markdown: Update All TOCs",
      "detail": "Opens all .md files and saves them to trigger TOC updates",
      "type": "shell",
      "command": "find",
      "args": [
        ".",
        "-name",
        "'*.md'",
        "-type",
        "f",
        "!",
        "-path",
        "'*/node_modules/*'",
        "!",
        "-path",
        "'*/vendor/*'",
        "-exec",
        "code",
        "{}",
        "+"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "echo": true
      },
      "group": "none"
    },
    {
      "label": "Markdown: Update TOCs (Current Folder)",
      "detail": "Opens all .md files in current folder for TOC update",
      "type": "shell",
      "command": "find",
      "args": [
        "${fileDirname}",
        "-maxdepth",
        "1",
        "-name",
        "'*.md'",
        "-type",
        "f",
        "-exec",
        "code",
        "{}",
        "+"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "group": "none"
    },
